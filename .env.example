# Nearacles Oracle Node - Environment Configuration Template
# Copy this file to .env and fill in your values

# ========== NEAR Configuration ==========
NEAR_NETWORK=testnet
NEAR_NODE_URL=https://rpc.testnet.near.org
NEAR_CONTRACT_ID=oracle-v3.nearacles.testnet
NEAR_ACCOUNT_ID=your-oracle-node.testnet
NEAR_PRIVATE_KEY=ed25519:YOUR_PRIVATE_KEY_HERE

# ========== OpenAI Configuration ==========
OPENAI_API_KEY=sk-YOUR_OPENAI_API_KEY

# ========== TEE Configuration ==========
# Set to 'enabled' to activate TEE mode, leave empty or 'disabled' for development
TEE_MODE=disabled

# TEE Environment: 'production' for real TEE, 'development' for mock
TEE_ENV=development

# TEE Provider: 'dstack' or 'phala'
TEE_PROVIDER=dstack

# Dstack Configuration (for production TEE)
DSTACK_API_KEY=
DSTACK_DEPLOYMENT_ID=
DSTACK_DEPLOYMENT_URL=

# Phala Configuration (alternative to Dstack)
PHALA_API_KEY=

# ========== Oracle Configuration ==========
# Minimum stake required to register as solver (in yoctoNEAR)
MIN_STAKE_AMOUNT=1000000000000000000000000

# Price update interval in milliseconds (default: 60000 = 1 minute)
PRICE_UPDATE_INTERVAL=60000

# Minimum number of price sources required
MIN_PRICE_SOURCES=5

# ========== Server Configuration ==========
PORT=3000
NODE_ENV=production

# ========== Logging ==========
LOG_LEVEL=info

# ========== Security ==========
# Add additional security configurations as needed
